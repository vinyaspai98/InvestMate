# InvestMate Backend Environment Configuration

# Server Configuration
PORT=8080
ENVIRONMENT=development

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./configs/firebase-service-account.json

# Logging
LOG_LEVEL=info

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Gmail API Configuration
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:4200/auth/callback

# Application Settings
GIN_MODE=debug

# Note: For production deployment:
# - Set ENVIRONMENT=production
# - Set GIN_MODE=release  
# - Update CORS_ALLOWED_ORIGINS to include your production frontend domain
# - Ensure Firebase service account credentials are properly configured
# - Set LOG_LEVEL=warn or LOG_LEVEL=error for production